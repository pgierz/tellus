# Tellus REST API Production Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control!

# ============================================================================
# Application Settings
# ============================================================================
TELLUS_VERSION=0.1.0
TELLUS_ENV=production
TELLUS_LOG_LEVEL=INFO

# ============================================================================
# API Configuration
# ============================================================================
TELLUS_API_PORT=1968
API_WORKERS=4  # Number of Uvicorn workers (usually CPU count * 2)
API_TIMEOUT=300  # Request timeout in seconds

# ============================================================================
# Database Configuration
# ============================================================================
POSTGRES_DB=tellus
POSTGRES_USER=tellus
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD  # ⚠️ REQUIRED: Use a strong password!
POSTGRES_PORT=5433  # Host port (5432 is used internally)
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_WORK_MEM=4MB

# ============================================================================
# Security
# ============================================================================
# API Key for authenticated endpoints (optional, but recommended)
TELLUS_API_KEY=

# CORS origins (comma-separated list)
CORS_ORIGINS=http://localhost:3000,https://your-domain.com

# ============================================================================
# Data Directories
# ============================================================================
# Where Tellus stores its data (simulations.json, locations.json, etc.)
TELLUS_DATA_DIR=./data/tellus

# SSH keys directory for remote storage access
SSH_KEY_DIR=~/.ssh

# ============================================================================
# Nginx / Reverse Proxy Configuration
# ============================================================================
# Your domain name
DOMAIN=api.your-domain.com

# Email for Let's Encrypt SSL certificates
LETSENCRYPT_EMAIL=admin@your-domain.com

# ============================================================================
# Backup Configuration
# ============================================================================
# Backup schedule (cron format or @daily, @weekly, etc.)
BACKUP_SCHEDULE=@daily

# Number of backups to keep
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=6

# ============================================================================
# Monitoring (Optional - for future Prometheus/Grafana integration)
# ============================================================================
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000
# GRAFANA_ADMIN_PASSWORD=

# ============================================================================
# Development / Testing Overrides
# ============================================================================
# Uncomment for development mode
# TELLUS_ENV=development
# TELLUS_LOG_LEVEL=DEBUG
# API_WORKERS=1
